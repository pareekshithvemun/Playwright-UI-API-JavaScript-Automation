            {
                "position": "2",
                "data": {
                    "title": "The Importance of Taking This Course",
                    "isVisible": true,
                    "duration": 60,
                    "isUserCreated": true,
                    "contents": [
                        {
                            "type": 3,
                            "title": "A Message From HR",
                            "duration": 60,
                            "policy": null,
                            "text": {
                                "text": "Here at Skillsoft, we take the well being of our employees very seriously. As an organization, we have zero tolarance for harassment or bullying for any reason. Discrimination and harassment at work can have a corrosive effect on an organization's culture and can lead to low employee morale, reduced productivity, and even criminal liability.<br /><br />This course will provide an overview of the types of behaviors that can give rise to discrimination, harassment, and retaliation claims, including those based on sex, race, color, national origin, religion, age, and disability. It will also discuss the benefits of and strategies for promoting a respectful work environment that is free of all forms of harassment, intimidation, and discrimination.<br /><br />If you have questions about harassment either during or after this course, please contact your local HR representative.<br /><br />We hope you enjoy this course.&nbsp;<br /><br />Thank you,<br /><br />The HR Team",
                                "audioDescription": null
                            },
                            "video": null
                        }
                    ]
                }
            },
            {
                "position": "4",
                "data": {
                    "title": "Our Anti-Harassment Policy",
                    "isVisible": true,
                    "duration": 180,
                    "isUserCreated": true,
                    "contents": [
                        {
                            "type": 2,
                            "title": "Review and Attest to Our Policy",
                            "duration": 180,
                            "policy": {
                                "additionalText": "<h3><em>You are required to review our anti-harassment policy in order to proceed in the course.</em></h3>\n<h4>If you have any questions or issues to report, please contact our HR department at <a href=\"hr@skillsoft.com\" target=\"_blank\" rel=\"noopener\">hr@skillsoft.com</a> or call 1-800-867-5309.<br /><br />You can also report any issues through our hotline at <a href=\"http://www.skillsoft.speakup.com\" target=\"_blank\" rel=\"noopener\">www.skillsoft.speakup.com</a>.</h4>",
                                "attestationQuestions": [
                                    "I confirm I have read and will abide by the policy and will report any issues or violations."
                                ],
                                "audioDescription": null,
                                "document": {
                                    "fileId": "224bcaed-f319-4520-b0ea-53a2ff871863",
                                    "fileName": "java001_0da732ce-c4b6-411a-a03a-fba3b1b7676c_v1_161547_23Oct2024.pdf",
                                    "description": null,
                                    "type": 1
                                },
                                "documentLink": null
                            },
                            "text": null,
                            "video": null
                        }
                    ]
                }
            },
            {
                "position": "24",
                "data": {
                    "title": "In Closing",
                    "isVisible": true,
                    "duration": 0,
                    "isUserCreated": true,
                    "contents": [
                        {
                            "type": 3,
                            "title": "Thank You and Reminder",
                            "duration": null,
                            "policy": null,
                            "text": {
                                "text": "<h4>Thank you for taking this course. <br /><br />As a reminder, if you have any questions or issues to report, please contact our HR department at <a href=\"hr@skillsoft.com\" target=\"_blank\" rel=\"noopener\">hr@skillsoft.com</a> or call 1-800-867-5309.<br /><br />You can also report any issues through our hotline at <a href=\"http://www.skillsoft.speakup.com\" target=\"_blank\" rel=\"noopener\">www.skillsoft.speakup.com</a>.</h4>",
                                "audioDescription": null
                            },
                            "video": null
                        }
                    ]
